{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-auth",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "PAGES_URL": "https://felipecs613-art.github.io/aura" },
  "durable_objects": {
    "bindings": [{ "name": "AURA", "class_name": "AuraStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuraStore"] }]
}
